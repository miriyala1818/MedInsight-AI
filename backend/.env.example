APP_NAME=Medical Research Assistant
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/medical_research

# ── Vector store ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_research_chunks

# ── Trusted sources ───────────────────────────────────────────────────────────
TRUSTED_SOURCES=["PubMed","Nature","WHO","NIH"]

# ── LLM provider ─────────────────────────────────────────────────────────────
# Option A — Google Gemini (recommended)
#   LLM_API_KEY=your_gemini_api_key_here
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.0-flash
#
# Option B — OpenAI
#   LLM_API_KEY=your_openai_api_key_here
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# Option C — Any OpenAI-compatible provider (Together, Groq, Mistral, etc.)
#   LLM_API_KEY=your_key
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama3-70b-8192

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=60

# ── PubMed / NCBI ─────────────────────────────────────────────────────────────
# Optional but recommended: add your email and API key for higher rate limits.
# Register at: https://www.ncbi.nlm.nih.gov/account/
NCBI_EMAIL=
NCBI_API_KEY=
